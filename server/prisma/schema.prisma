generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  firstName     String
  lastName      String

  walletAddress String?  @unique
  walletNonce   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
